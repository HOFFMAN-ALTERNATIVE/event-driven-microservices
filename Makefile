.PHONY: test integration lint build docker up down smoke dlq
test:        ; go test -race -count=1 ./...
integration: ; go test -race -count=1 -tags integration -v ./test/integration/...
lint:        ; golangci-lint run --build-tags integration ./...
build:       ; CGO_ENABLED=0 go build -trimpath -o bin/ ./cmd/...
docker:      ; docker build -t event-driven-microservices:local .
up:          ; docker compose up -d --build --wait
down:        ; docker compose down -v
smoke:       ; ./scripts/smoke.sh
dlq:         ; go run ./cmd/dlqctl list
